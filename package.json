    "README.md",
    "LICENSE",
    "go.mod"
  ],
  "optionalDependencies": {
    "@walsyrea/platform-darwin-arm64": "1.0.0",
    "@walsyrea/platform-darwin-amd64": "1.0.0",
    "@walsyrea/platform-linux-amd64": "1.0.0",
    "@walsyrea/platform-linux-arm64": "1.0.0",
    "@walsyrea/platform-win32-x64": "1.0.0",
    "@walsyrea/platform-win32-arm64": "1.0.0"
  }
}
