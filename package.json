{
  "name": "walsyrea",
  "version": "1.0.0",
  "description": "Read-only reverse-engineering skill and MCP server backed by lrecon",
  "license": "MIT",
  "bin": {
    "walsyrea": "bin/walsyrea.js",
    "walsyrea-mcp": "bin/walsyrea-mcp.js"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=18"
  },
  "files": [
